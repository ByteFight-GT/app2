{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bytefightapp",
  "version": "../package.json",
  "identifier": "org.bytefight.bytefightapp",
  "build": {
    "beforeDevCommand": "npm run next:dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run next:build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bytefight App",
        "width": 1200,
        "height": 800,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../engine/": "engine/",
      "../resources/default-settings.json": "resources/default-settings.json",
      "../resources/default-maps/": "resources/default-maps/",
      "../resources/example-bot/": "resources/example-bot/"
    }
  }
}
